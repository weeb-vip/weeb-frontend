{
  "name": "transplex-frontend",
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite dev",
    "build": "vite build",
    "preview": "vite preview --port 4321",
    "start": "node build/index.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test tests/e2e/mobile.spec.ts",
    "test:e2e:registration": "playwright test tests/e2e/registration.spec.ts",
    "test:e2e:registration:headed": "playwright test tests/e2e/registration.spec.ts --headed",
    "test:e2e:registration:direct": "playwright test tests/e2e/registration-direct.spec.ts",
    "test:e2e:ios": "IOS_SIMULATOR=true playwright test --project=ios-simulator",
    "test:e2e:android": "ANDROID_EMULATOR=true playwright test --project=android-emulator",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "update-deployment-tags": "node scripts/update-deployment-tags.js",
    "deploy:staging": "node scripts/deploy-cloudflare.js staging",
    "deploy:production": "node scripts/deploy-cloudflare.js production",
    "deploy:cf": "node scripts/deploy-cloudflare.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "check:gate": "node scripts/svelte-check-gate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weeb-vip/weeb-frontend.git"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.19.4",
    "@algolia/autocomplete-preset-algolia": "^1.19.4",
    "@date-fns/tz": "^1.4.1",
    "@date-fns/utc": "^2.1.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/svelte-query": "^5.89.0",
    "algoliasearch": "^5.37.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "graphql": "^16.6.0",
    "graphql-request": "^6.0.0",
    "lottie-web": "^5.13.0",
    "motion": "^12.10.5",
    "query-string": "^8.1.0",
    "svelte": "^5.56.5",
    "svelte-fa": "^4.0.4",
    "svelte-sonner": "^1.0.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/client-preset": "^3.0.1",
    "@jest/globals": "^30.1.1",
    "@playwright/test": "^1.55.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@storybook/svelte": "^10.4.0",
    "@storybook/svelte-vite": "^10.4.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.11",
    "@types/qs": "^6.9.7",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.14",
    "jest": "^30.1.1",
    "postcss": "^8.4.21",
    "puppeteer": "^24.22.3",
    "sass": "^1.62.1",
    "semantic-release": "^17.4.7",
    "storybook": "^10.4.0",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^3.3.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4",
    "uuid": "^12.0.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-static-copy": "^0.13.1",
    "wrangler": "^4.111.0"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
